DATABASE_URL=postgresql://user:password@localhost:5432/database_name
TEST_DATABASE_URL=postgresql://smartwaste_test:test-only-password@localhost:55433/smartwaste_test
POSTGRES_TEST_PASSWORD=test-only-password
POSTGRES_TEST_PORT=55433
POSTGRES_USER=smartwaste
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=smartwaste_db
MODEL_TYPE_PATH=./modele_12classes.onnx
MODEL_BINARY_PATH=./modele_2classes.onnx
MODEL_SEVERITY_PATH=./smartwaste_mobilenetv2_clean.onnx
MODEL_VERSION=local
JWT_SECRET_KEY=replace-with-a-random-secret
COPERNICUS_USERNAME=replace-with-copernicus-username
COPERNICUS_PASSWORD=replace-with-copernicus-password
TEST_ADMIN_PASSWORD=test-only-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-redis-password
CORS_ORIGINS=http://localhost:8000
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192
MAX_IMAGE_PIXELS=40000000
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_ENV=development
HTTPS_ENABLED=false
WEBSOCKET_ORIGINS=http://localhost:8000
LOG_FORMAT=text
CHATBOT_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' data: https://*.tile.openstreetmap.org; style-src 'self' 'unsafe-inline' https://unpkg.com; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
SUPPORT_PHONE=+237600000000
MEDIA_STORAGE_PATH=./var/private_media
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=10
ROUTING_PROVIDER=disabled
ROUTING_MAX_STOPS=50
ROUTING_FAILURE_THRESHOLD=3
ROUTING_FAILURE_COOLDOWN_SECONDS=30
POSITION_MIN_INTERVAL_SECONDS=10
POSITION_RETENTION_MINUTES=120
POSITION_MAX_ACCURACY_METERS=250
POSITION_STALE_SECONDS=120
GPS_RETENTION_DAYS=30
GPS_UPDATE_INTERVAL_SECONDS=10
DEFAULT_LANGUAGE=fr
